{
  "name": "loom-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "check": "turbo run build typecheck test lint",
    "dev": "turbo run dev",
    "test:integration": "turbo run test:integration",
    "test:browser": "turbo run test:browser",
    "test:cloud": "turbo run test:cloud"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "oxlint": "1.85.0",
    "turbo": "2.11.2",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "drizzle-kit@1.0.0-rc.4": "patches/drizzle-kit@1.0.0-rc.4.patch"
  }
}

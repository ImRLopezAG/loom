---
import Layout from "../components/layout.astro";
---
<Layout title="Page not found" description="Find your way back to the Loom documentation.">
  <main class="mx-auto max-w-2xl px-6 py-24">
    <a href="/" class="text-fd-primary">Loom documentation</a>
    <h1 class="mt-10 text-3xl font-semibold">Page not found</h1>
    <p class="my-6 text-fd-muted-foreground">This address does not match a documentation page.</p>
    <a href="/quickstart" class="underline">Open the quickstart</a>
  </main>
</Layout>

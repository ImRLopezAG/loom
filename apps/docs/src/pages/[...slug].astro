---
import { render, type CollectionEntry } from "astro:content";
import defaultMdxComponents from "fumadocs-ui/mdx";
import { Docs } from "../components/docs";
import Layout from "../components/layout.astro";
import { source } from "../lib/source";

interface Props { entry: CollectionEntry<"docs"> }
export function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length ? page.slugs.join("/") : undefined },
    props: { entry: page.data.entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.map((heading) => ({ depth: heading.depth, title: heading.text, url: `#${heading.slug}` }));
---
<Layout title={entry.data.title} description={entry.data.description}>
  <Docs tree={source.getPageTree()} pathname={Astro.url.pathname} toc={toc} client:load>
    <h1 class="text-3xl font-semibold tracking-tight">{entry.data.title}</h1>
    <p class="text-lg text-fd-muted-foreground mb-8">{entry.data.description}</p>
    <div class="prose flex-1"><Content components={defaultMdxComponents} /></div>
  </Docs>
</Layout>

{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@loom/docs#typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["LOOM_TEST_DATABASE_URL"]
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:cloud": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["LOOM_NEON_TEST_PROJECT_ID", "LOOM_NEON_TEST_BRANCH_ID", "NEON_API_KEY"]
    },
    "migrate": {
      "cache": false
    },
    "deploy": {
      "cache": false
    },
    "release": {
      "cache": false
    },
    "//#check:static": {
      "dependsOn": ["@loom/core#build", "@loom/tooling#build"]
    }
  },
  "globalDependencies": ["vite.config.ts"]
}

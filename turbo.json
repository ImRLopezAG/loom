{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@loom/docs#typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["LOOM_TEST_DATABASE_URL"]
    },
    "test:browser": {
      "dependsOn": ["^build", "@loom/docs#build", "@loom/example-tasks#build", "@loom/example-jobs-storage#build"],
      "cache": false,
      "passThroughEnv": ["LOOM_TEST_DATABASE_URL"]
    },
    "test:cloud": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "LOOM_CLOUD_PROJECT_ID",
        "LOOM_CLOUD_BRANCH_ID",
        "LOOM_CLOUD_FUNCTIONS",
        "LOOM_CLOUD_EXAMPLE",
        "LOOM_CLOUD_CAPACITY",
        "NEON_API_KEY"
      ]
    },
    "migrate": {
      "cache": false
    },
    "deploy": {
      "cache": false
    },
    "release": {
      "cache": false
    },
    "//#check:static": {
      "dependsOn": ["@loom/core#build", "@loom/tooling#build"]
    },
    "@loom/example-tasks#typecheck": {
      "dependsOn": ["build"]
    },
    "@loom/example-tasks#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "backend/_generated/**"]
    },
    "@loom/example-jobs-storage#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "backend/_generated/**"]
    },
    "@loom/example-jobs-storage#typecheck": {
      "dependsOn": ["build"]
    }
  },
  "globalDependencies": ["vite.config.ts"]
}

# Run loom login, then loom link --project-id <project> --branch <isolated-branch>.
# Public frontend URLs; never put database credentials in VITE_* values.
VITE_NEON_AUTH_URL=
VITE_LOOM_URL=
VITE_LOOM_DEPLOYMENT=preview
APP_ORIGINS=http://localhost:5173
# Local backend development uses Neon-managed values from the selected branch:
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# Restricted application credential and separate migration credential:
LOOM_DATABASE_URL=
LOOM_MIGRATION_DATABASE_URL=
LOOM_ACTIVATION_TOKEN=

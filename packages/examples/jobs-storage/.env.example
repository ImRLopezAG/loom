# Existing Neon project: loom (late-moon-69483649). Use an isolated branch.
NEON_BRANCH_ID=
# A distinct disposable branch for loom dev; never reuse preview/production.
NEON_DEVELOPMENT_BRANCH_ID=
NEON_API_KEY=
NEON_DATABASE_NAME=neondb
NEON_MIGRATION_ROLE=neondb_owner
# Separate restricted application and migration credentials; never expose to Vite.
LOOM_DATABASE_URL=
LOOM_MIGRATION_DATABASE_URL=
LOOM_ACTIVATION_TOKEN=
# Public URLs only.
VITE_NEON_AUTH_URL=
VITE_LOOM_URL=
VITE_LOOM_DEPLOYMENT=preview
VITE_APP_ORIGIN=http://localhost:5173
# Only for `loom dev` against remote storage; Neon Functions inject these on deploy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1

import assert from "node:assert/strict";
import { readFile, rm } from "node:fs/promises";
import { pathToFileURL } from "node:url";
import { call, getRouter, Procedure } from "@orpc/server";
import { Context } from "effect";
import { createRpcRuntime, defineRpcAuth, Invocation } from "kello/server";
import pg from "pg";

assert.equal(process.versions.node.split(".")[0], "24");
const { version, schema, mode } = JSON.parse(await readFile("generation.json", "utf8"));
const selected = mode === "selected" || mode === "custom";
const { runtimeOptions } = await import(pathToFileURL(`${process.cwd()}/.loom/generations/${version}/runtime.js`).href);
const options = runtimeOptions();
const adminUrl = process.env.LOOM_PACKED_HSTORE_DATABASE_URL;
assert(adminUrl);
const principal = JSON.parse(await readFile("runtime-principal.private.json", "utf8"));
assert.notEqual(principal.connectionString, adminUrl);
assert.notEqual(new URL(principal.connectionString).username, new URL(adminUrl).username);
const oracle = new pg.Client({ connectionString: adminUrl });
let runtime;
try {
  await oracle.connect();
  const restricted = new pg.Client({ connectionString: principal.connectionString });
  try {
    await restricted.connect();
    assert.deepEqual(
      (
        await restricted.query(
          "SELECT current_user name,rolcanlogin,rolsuper,rolcreatedb,rolcreaterole,rolreplication,rolbypassrls FROM pg_roles WHERE rolname=current_user",
        )
      ).rows,
      [
        {
          name: principal.role,
          rolcanlogin: true,
          rolsuper: false,
          rolcreatedb: false,
          rolcreaterole: false,
          rolreplication: false,
          rolbypassrls: false,
        },
      ],
    );
  } finally {
    await restricted.end();
  }
  runtime = await createRpcRuntime({
    ...options,
    connectionString: principal.connectionString,
    deployment: "cold-hstore-consumer",
    auth: defineRpcAuth({ authorize: async () => {} }),
    assertActive: async (signal) => signal.throwIfAborted(),
  });
  const route = getRouter(runtime.router, ["tasks", "list"]);
  assert(route instanceof Procedure);
  async function invoke() {
    const invocation = { requestId: `cold-hstore-${mode}`, identity: null, signal: new AbortController().signal };
    return call(route, undefined, {
      context: { ...invocation, operation: "query", "effect/context": Context.make(Invocation, invocation) },
      path: ["tasks", "list"],
    });
  }
  const actual = await invoke();
  if (selected) {
    const { extensions } = await import(pathToFileURL(`${process.cwd()}/kello/_generated/extensions.ts`).href);
    const expected = {
      version: "1.8",
      placement: schema,
      members: Object.keys(extensions.hstore.sql.overloads).sort(),
      populated: "populated",
      replaced: "replaced",
    };
    assert.equal(expected.members.length, 66);
    assert.deepEqual(actual, { root: expected, child: expected });
    // A native permission failure remains a permission failure through actual generated root/mounted RPC.
    await oracle.query(
      `REVOKE USAGE ON SCHEMA ${pg.escapeIdentifier(schema)} FROM ${pg.escapeIdentifier(principal.role)}`,
    );
    await assert.rejects(invoke());
    const forbidden = new pg.Client({ connectionString: principal.connectionString });
    try {
      await forbidden.connect();
      await assert.rejects(
        forbidden.query(
          `SELECT ${pg.escapeIdentifier(schema)}.fetchval($1::${pg.escapeIdentifier(schema)}.hstore,'stored')`,
          ['"stored"=>NULL'],
        ),
        (error) => error.code === "42501",
      );
    } finally {
      await forbidden.end();
    }
  } else {
    const expected = { status: mode === "future" ? "unverified" : "absent", value: 1, effectSame: true };
    assert.deepEqual(actual, { root: expected, child: expected });
  }
  console.log(`Cold Node24 Hstore ${mode} generated root/mounted RPC/Effect passed with a separate restricted LOGIN`);
} finally {
  try {
    await runtime?.stop();
  } finally {
    try {
      if ((await oracle.query("SELECT 1 FROM pg_roles WHERE rolname=$1", [principal.role])).rowCount)
        await oracle.query(
          `GRANT ${pg.escapeIdentifier(principal.role)} TO CURRENT_USER; DROP OWNED BY ${pg.escapeIdentifier(principal.role)}; DROP ROLE ${pg.escapeIdentifier(principal.role)}`,
        );
      assert.equal((await oracle.query("SELECT 1 FROM pg_roles WHERE rolname=$1", [principal.role])).rowCount, 0);
      await rm("runtime-principal.private.json", { force: true });
    } finally {
      await oracle.end();
    }
  }
}

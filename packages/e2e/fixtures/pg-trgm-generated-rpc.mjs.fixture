import assert from "node:assert/strict";
import { readFile } from "node:fs/promises";
import { pathToFileURL } from "node:url";
import { call, getRouter, Procedure } from "@orpc/server";
import { Context } from "effect";
import { createRpcRuntime, defineRpcAuth, Invocation } from "kello/server";
import pg from "pg";

assert.equal(process.versions.node.split(".")[0], "24");
const { version, schema, selected, mode, members, inputs } = JSON.parse(await readFile("generation.json", "utf8"));
const { runtimeOptions } = await import(pathToFileURL(`${process.cwd()}/.loom/generations/${version}/runtime.js`).href);
const options = runtimeOptions();
const adminUrl = process.env.LOOM_PACKED_PG_TRGM_DATABASE_URL;
assert(adminUrl);
const principal = JSON.parse(await readFile("runtime-principal.private.json", "utf8"));
assert.notEqual(principal.connectionString, adminUrl);
const oracle = new pg.Client({ connectionString: adminUrl });
let runtime;
try {
  await oracle.connect();
  const restricted = new pg.Client({ connectionString: principal.connectionString });
  try {
    await restricted.connect();
    const row = (await restricted.query("SELECT current_user AS name, rolsuper, rolcreatedb, rolcreaterole, rolreplication, rolbypassrls, rolcanlogin FROM pg_roles WHERE rolname=current_user")).rows[0];
    assert.deepEqual(row, { name: principal.role, rolsuper: false, rolcreatedb: false, rolcreaterole: false, rolreplication: false, rolbypassrls: false, rolcanlogin: true });
    assert.notEqual(principal.role, (await oracle.query("SELECT current_user AS name")).rows[0].name);
    await assert.rejects(restricted.query("CREATE EXTENSION IF NOT EXISTS citext"));
    if (selected) assert.equal((await restricted.query(`SELECT ${pg.escapeIdentifier(schema)}.similarity($1,$2) > 0 AS ok`, [inputs.left, inputs.right])).rows[0].ok, true);
  } finally { await restricted.end(); }
  runtime = await createRpcRuntime({ ...options, connectionString: principal.connectionString, deployment: "pg-trgm-consumer", auth: defineRpcAuth({ authorize: async () => {} }), assertActive: async signal => signal.throwIfAborted() });
  const route = getRouter(runtime.router, ["tasks", "list"]);
  assert(route instanceof Procedure);
  const invocation = { requestId: `cold-pg-trgm-${mode}`, identity: null, signal: new AbortController().signal };
  const actual = await call(route, undefined, {
    context: { ...invocation, operation: "query", "effect/context": Context.make(Invocation, invocation) },
    path: ["tasks", "list"],
  });
  let expected;
  if (selected) {
    const s = pg.escapeIdentifier(schema);
    // These four captured results are float4; float8 exposes their exact value through pg's text parser.
    const native = (await oracle.query(`SELECT ${s}.similarity($1,$2)::float8 AS similarity, ${s}.word_similarity($1,$2)::float8 AS word_similarity, ${s}.strict_word_similarity($1,$2)::float8 AS strict_word_similarity, ($1 OPERATOR(${s}.<->) $2)::float8 AS distance, $1 OPERATOR(${s}.%) $2 AS similar, ${s}.similarity(NULL,$2) AS missing, ${s}.show_trgm($3) AS trigrams`, [inputs.left, inputs.right, inputs.trigrams])).rows[0];
    expected = { schema, version: "1.6", similarity: native.similarity, wordSimilarity: native.word_similarity, strictWordSimilarity: native.strict_word_similarity, distance: native.distance, similar: native.similar, missing: null, trigrams: native.trigrams, members: [...members].sort(), effectSame: true };
    assert(native.similarity > 0 && native.similarity < 1 && native.trigrams.length > 0);
  } else expected = { status: mode === "future" ? "unverified" : "absent", value: 1, effectSame: true };
  assert.deepEqual(actual, expected);
  console.log(`Cold Node24 generated host and mounted RPC/Effect matched the native pg_trgm oracle (${mode}) with a separate non-administrative LOGIN principal.`);
} finally {
  try { await runtime?.stop(); } finally {
    try {
      if ((await oracle.query("SELECT 1 FROM pg_roles WHERE rolname=$1", [principal.role])).rowCount)
        await oracle.query(`GRANT ${pg.escapeIdentifier(principal.role)} TO CURRENT_USER; DROP OWNED BY ${pg.escapeIdentifier(principal.role)}; DROP ROLE ${pg.escapeIdentifier(principal.role)}`);
    } finally { await oracle.end(); }
  }
}

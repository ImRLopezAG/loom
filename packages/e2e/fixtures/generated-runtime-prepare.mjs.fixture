import assert from "node:assert/strict";
import { createHash, randomBytes, randomUUID } from "node:crypto";
import { appendFileSync } from "node:fs";
import { readFile, writeFile } from "node:fs/promises";
import { pathToFileURL } from "node:url";
import pg from "pg";
import { bootstrapDatabase } from "kello/tooling";

// Preparation executes with Bun and explicit operator credentials; the cold Node process receives a separate LOGIN.
const family = process.argv[2];
assert(["neon_utils", "lakebase_text"].includes(family));
const connectionString = process.env.LOOM_GENERATED_RUNTIME_DATABASE_URL;
assert(connectionString);
const { version, schema, selection = "selected" } = JSON.parse(await readFile("generation.json", "utf8"));
const { runtimeOptions } = await import(pathToFileURL(`${process.cwd()}/.loom/generations/${version}/runtime.js`).href);
const options = runtimeOptions();
const role = `loom_${family === "neon_utils" ? "cpu" : "bm25"}_rpc_${randomUUID().replaceAll("-", "")}`;
const roleFile = process.env.LOOM_EXTENSION_PROOF_ROLE_OUTPUT;
if (roleFile) appendFileSync(roleFile, JSON.stringify({ runId: process.env.LOOM_EXTENSION_PROOF_RUN_ID, name: role, sha256: createHash("sha256").update(role).digest("hex") }) + "\n", { mode: 0o600 });
const client = new pg.Client({ connectionString });
try {
  await client.connect();
  await bootstrapDatabase({ connectionString, metadataNamespace: options.metadataNamespace, runtimeRole: role });
  const password = randomBytes(32).toString("hex");
  await client.query(`ALTER ROLE ${pg.escapeIdentifier(role)} LOGIN PASSWORD '${password}'`);
  if (selection === "selected") {
    await client.query(`CREATE SCHEMA ${pg.escapeIdentifier(schema)}; CREATE EXTENSION ${pg.escapeIdentifier(family)} WITH SCHEMA ${pg.escapeIdentifier(schema)} VERSION '${family === "neon_utils" ? "1.1" : "0.1.3"}'; GRANT USAGE ON SCHEMA ${pg.escapeIdentifier(schema)} TO ${pg.escapeIdentifier(role)}`);
    if (family === "lakebase_text") {
      await client.query(`CREATE TABLE public.lakebase_text_docs(vector tsvector); INSERT INTO public.lakebase_text_docs VALUES (to_tsvector('english', 'PostgreSQL BM25')), (to_tsvector('english', 'unrelated row')); CREATE INDEX documents_passage_bm25 ON public.lakebase_text_docs USING lakebase_bm25(vector); GRANT SELECT ON public.lakebase_text_docs TO ${pg.escapeIdentifier(role)}`);
      // The captured SQL-language function casts to an unqualified native type. This is an owned-role prerequisite,
      // not a change to the ordinary query helper or the caller's existing backend.
      const prerequisite = new pg.Client({ connectionString: (() => { const address = new URL(connectionString); address.username = role; address.password = password; return address.href; })() });
      await prerequisite.connect();
      try {
        await assert.rejects(prerequisite.query(`SELECT ${pg.escapeIdentifier(schema)}.to_bm25query($1::tsvector, 'documents_passage_bm25')`, ["'postgresql':1"]), error => error.code === "42704");
      } finally { await prerequisite.end(); }
      await client.query(`ALTER ROLE ${pg.escapeIdentifier(role)} SET search_path TO ${pg.escapeIdentifier(schema)}, public, pg_catalog`);
    }
  }
  const runtimeAddress = new URL(connectionString);
  runtimeAddress.username = role;
  runtimeAddress.password = password;
  await writeFile("runtime-principal.private.json", JSON.stringify({ role, connectionString: runtimeAddress.href }), { mode: 0o600, flag: "wx" });
} catch (error) {
  if ((await client.query("SELECT 1 FROM pg_roles WHERE rolname=$1", [role])).rowCount)
    await client.query(`DROP OWNED BY ${pg.escapeIdentifier(role)}; DROP ROLE ${pg.escapeIdentifier(role)}`);
  throw error;
} finally { await client.end(); }

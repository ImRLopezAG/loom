# Private postgis_sfcgal 3.6.4 oracle linked to SFCGAL v2.3.0 (tag dc9791190d41) so every library-gated member runs natively; two compiler jobs.
# The core image deliberately built liblwgeom without SFCGAL; only liblwgeom.a is rebuilt here so the installed core postgis-3.so stays byte-identical.
FROM loom-postgis-core-3.6.4-pg18:local
RUN apt-get update && apt-get install -y --no-install-recommends cmake libcgal-dev libboost-serialization-dev libboost-dev libgmp-dev libmpfr-dev nlohmann-json3-dev && rm -rf /var/lib/apt/lists/*
COPY SFCGAL-v2.3.0.tar.gz /tmp/
RUN echo '5f6aa1838e5ae31523ebf410cde0240b7a88d7e062b7ffff945e4fae2aaba0fa  /tmp/SFCGAL-v2.3.0.tar.gz' | sha256sum -c - && tar -xzf /tmp/SFCGAL-v2.3.0.tar.gz -C /tmp && cmake -S /tmp/SFCGAL-v2.3.0 -B /tmp/sfcgal-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DSFCGAL_BUILD_TESTS=OFF -DSFCGAL_BUILD_EXAMPLES=OFF -DSFCGAL_BUILD_VIEWER=OFF && cmake --build /tmp/sfcgal-build -j2 && cmake --install /tmp/sfcgal-build && ldconfig && rm -rf /tmp/sfcgal-build
RUN cd /tmp/postgis-3.6.4 && echo 'ed8dc6679f1e06f7b113592b04cde2a7e00f1b1e681294c8ca2204058990cec6  /tmp/postgis-3.6.4.tar.gz' | sha256sum -c - && ./configure --without-raster --without-topology --without-address-standardizer --with-sfcgal=/usr/local/bin/sfcgal-config && make -C liblwgeom clean && make -j2 -C liblwgeom && make -j2 -C sfcgal && make -j2 -C extensions/postgis_sfcgal sql/postgis_sfcgal--3.6.4.sql postgis_sfcgal.control && make -C sfcgal install && install -m644 extensions/postgis_sfcgal/postgis_sfcgal.control extensions/postgis_sfcgal/sql/postgis_sfcgal--3.6.4.sql "$(pg_config --sharedir)/extension/"

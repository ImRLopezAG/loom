# Private native oracle for the rdkit 4.8.0 cartridge (Release_2025_09_1, first 4.8.0 release).
# Flags mirror Neon's published compute rdkit layer; sortsupport options stay at upstream defaults.
FROM postgres:18
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates postgresql-server-dev-18 libboost-all-dev libeigen3-dev libfreetype-dev zlib1g-dev && rm -rf /var/lib/apt/lists/*
COPY rdkit-Release_2025_09_1.tar.gz /tmp/
RUN echo '7fb3510b69af358009e2d0763c1d9665ac34f4c2cd3314cf5210ee3d5a33d501  /tmp/rdkit-Release_2025_09_1.tar.gz' | sha256sum -c - && mkdir /tmp/rdkit && tar -xzf /tmp/rdkit-Release_2025_09_1.tar.gz -C /tmp/rdkit --strip-components=1 && cmake -S /tmp/rdkit -B /tmp/rdkit-build -D RDK_BUILD_CAIRO_SUPPORT=OFF -D RDK_BUILD_INCHI_SUPPORT=ON -D RDK_BUILD_AVALON_SUPPORT=ON -D RDK_BUILD_PYTHON_WRAPPERS=OFF -D RDK_BUILD_DESCRIPTORS3D=OFF -D RDK_BUILD_FREESASA_SUPPORT=OFF -D RDK_BUILD_COORDGEN_SUPPORT=ON -D RDK_BUILD_MOLINTERCHANGE_SUPPORT=OFF -D RDK_BUILD_YAEHMOP_SUPPORT=OFF -D RDK_BUILD_STRUCTCHECKER_SUPPORT=OFF -D RDK_TEST_MULTITHREADED=OFF -D RDK_BUILD_CPP_TESTS=OFF -D RDK_USE_URF=OFF -D RDK_BUILD_PGSQL=ON -D RDK_PGSQL_STATIC=ON -D PostgreSQL_CONFIG=pg_config -D PostgreSQL_INCLUDE_DIR="$(pg_config --includedir)" -D PostgreSQL_TYPE_INCLUDE_DIR="$(pg_config --includedir-server)" -D PostgreSQL_LIBRARY_DIR="$(pg_config --libdir)" -D RDK_INSTALL_INTREE=OFF -D RDK_INSTALL_COMIC_FONTS=OFF -D RDK_BUILD_FREETYPE_SUPPORT=OFF -D CMAKE_BUILD_TYPE=Release && make -C /tmp/rdkit-build -j2 && make -C /tmp/rdkit-build install && rm -rf /tmp/rdkit-build /tmp/rdkit
